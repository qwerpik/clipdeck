<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "binaries": clipdeck.exe and clipdeck_micfx.dll, uploaded by
     the release workflow as a GitHub artifact (a ZIP). Parameter: version (e.g. 0.2.0). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="clipdeck.exe" product-name="Clipdeck" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="clipdeck_micfx.dll" product-name="Clipdeck" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
